---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import type { Dict } from '../i18n/en'

interface Props {
  t: Dict
  title?: string
  description?: string
  /** This page's path in English, e.g. "/blog/x". The Arabic one is "/ar" + it. */
  enPath: string
  /** False for pages that exist only in one language (legal pages). */
  hasAlt?: boolean
  nav?: boolean
  jsonLd?: Record<string, unknown>
}

const { t, title = t.meta.title, description = t.meta.description, enPath, hasAlt = true, nav = true, jsonLd } = Astro.props
const site = 'https://convrt.qa'
const arPath = enPath === '/' ? '/ar' : `/ar${enPath}`
const self = t.lang === 'ar' ? arPath : enPath
const canonical = new URL(self, site).href

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Convrt',
  url: site,
  email: 'support@convrt.qa',
  parentOrganization: { '@type': 'Organization', name: 'Redstone Technology' },
  areaServed: 'QA',
  address: { '@type': 'PostalAddress', addressLocality: 'Doha', addressCountry: 'QA' },
  description: 'Convrt builds the system between a business’s ads and the payment, so more of the people it already pays to reach become customers.',
}
---
<!doctype html>
<html lang={t.lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hasAlt && <link rel="alternate" hreflang="en" href={new URL(enPath, site).href} />}
    {hasAlt && <link rel="alternate" hreflang="ar" href={new URL(arPath, site).href} />}
    {hasAlt && <link rel="alternate" hreflang="x-default" href={new URL(enPath, site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F4F3F1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Convrt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:locale" content={t.lang === 'ar' ? 'ar_QA' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {nav && <Nav t={t} enPath={enPath} hasAlt={hasAlt} />}
    <main id="main">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>
