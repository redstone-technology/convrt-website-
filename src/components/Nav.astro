---
import Logo from './Logo.astro'
import type { Dict } from '../i18n/en'
interface Props { t: Dict; enPath: string; hasAlt?: boolean }
const { t, enPath, hasAlt = true } = Astro.props
const home = t.lang === 'ar' ? '/ar' : '/'
const start = t.lang === 'ar' ? '/ar/start' : '/start'
const blog = t.lang === 'ar' ? '/ar/blog' : '/blog'
const alt = t.lang === 'ar' ? enPath : enPath === '/' ? '/ar' : `/ar${enPath}`
const switchHref = hasAlt ? alt : t.nav.switchHref
---
<header class="nav">
  <div class="wrap nav__in">
    <a href={home} class="nav__logo" aria-label="Convrt home"><Logo size={26} /></a>
    <nav class="nav__links" aria-label="Main">
      <a href={`${home}#how`}>{t.nav.how}</a>
      <a href={`${home}#results`}>{t.nav.results}</a>
      <a href={`${home}#services`}>{t.nav.services}</a>
      <a href={blog}>{t.nav.blog}</a>
    </nav>
    <div class="nav__end">
      <a href={switchHref} class="nav__lang" hreflang={t.lang === 'ar' ? 'en' : 'ar'} lang={t.lang === 'ar' ? 'en' : 'ar'}>{t.nav.switch}</a>
      <a href={start} class="btn nav__cta">{t.nav.cta}</a>
    </div>
  </div>
</header>
<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(244, 243, 241, 0.8);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
  }
  .nav__in {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 72px;
  }
  .nav__logo {
    display: inline-flex;
    text-decoration: none;
  }
  .nav__links {
    display: flex;
    gap: 28px;
    margin-inline-start: 16px;
  }
  .nav__links a,
  .nav__lang {
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .nav__links a:hover,
  .nav__lang:hover {
    color: var(--ink);
  }
  .nav__end {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-inline-start: auto;
  }
  .nav__cta {
    min-height: 42px;
    padding: 0 18px;
    font-size: 15px;
    box-shadow: none;
  }
  @media (max-width: 900px) {
    .nav__links {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .nav__in {
      gap: 12px;
      height: 64px;
    }
    .nav__end {
      gap: 12px;
    }
    .nav__cta {
      min-height: 38px;
      padding: 0 14px;
      font-size: 14px;
    }
  }
</style>
