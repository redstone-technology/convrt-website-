---
import Logo from './Logo.astro'
import type { Dict } from '../i18n/en'
interface Props { t: Dict; enPath: string; hasAlt?: boolean }
const { t } = Astro.props
// The Arabic site is served at ar.convrt.qa, where "/" and "/start" map to
// /ar and /ar/start. So links are root-relative in both languages.
const isAr = t.lang === 'ar'
const home = '/'
const start = '/start'
const blog = '/blog'
---
<header class="nav glass">
  <a href={home} class="nav__logo" aria-label="Convrt home"><Logo size={24} /></a>
  <nav class="nav__links" aria-label="Main">
    <a href={`${home}#segments`}>{t.nav.segments}</a>
    <a href={`${home}#how`}>{t.nav.how}</a>
    <a href={`${home}#results`}>{t.nav.results}</a>
    {!isAr && <a href={blog}>{t.nav.blog}</a>}
  </nav>
  <div class="nav__end">
    <a href={start} class="btn nav__cta">{t.nav.cta}</a>
  </div>
</header>
<style>
  .nav {
    position: fixed;
    top: 14px;
    left: 50%;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(1120px, 100% - 28px);
    height: 60px;
    padding: 0 10px 0 22px;
    border-radius: 999px;
    transform: translateX(-50%);
    box-shadow: 0 0 0 1px var(--edge-out), var(--lift-s);
  }
  :global(:root[dir='rtl']) .nav {
    padding: 0 22px 0 10px;
  }
  .nav__logo {
    justify-self: start;
    display: inline-flex;
    text-decoration: none;
  }
  .nav__links {
    display: flex;
    gap: 4px;
  }
  .nav__links a,
  .nav__lang {
    padding: 9px 15px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 14.5px;
    text-decoration: none;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .nav__links a:hover,
  .nav__lang:hover {
    color: var(--ink);
    background: var(--glass-inset);
  }
  .nav__end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav__cta {
    min-height: 40px;
    padding: 0 18px;
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .nav__links {
      display: none;
    }
    .nav {
      grid-template-columns: 1fr auto;
    }
  }
  @media (max-width: 420px) {
    .nav {
      padding: 0 8px 0 16px;
    }
    .nav__cta {
      padding: 0 14px;
      font-size: 13.5px;
    }
  }
</style>
