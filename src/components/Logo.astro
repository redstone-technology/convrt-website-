---
// The official Convrt wordmark (traced to SVG from the brand files).
// `size` keeps the old meaning: roughly the font size the logo sits beside.
import wordmark from '../assets/convrt-wordmark.svg?raw'
interface Props { size?: number; class?: string }
const { size = 26, class: cls = '' } = Astro.props
---
<span class={`logo ${cls}`} style={`--logo-size:${size}px`} role="img" aria-label="Convrt" dir="ltr" set:html={wordmark} />
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: #000;
    line-height: 0;
  }
  .logo :global(svg) {
    display: block;
    width: auto;
    height: calc(var(--logo-size) * 0.92);
  }
</style>
