---
import HeroDemo from './HeroDemo.tsx'
import type { Dict } from '../i18n/en'
interface Props { t: Dict; c: Dict['home']; segments?: boolean }
const { t, c, segments = false } = Astro.props
const prefix = ''
const start = `${prefix}/start`
const p = c.plan.frag
---
<!-- 1. Their goal -->
<section class="hero">
  <div class="wrap">
    <h1 class="hero__title">
      {c.hero.titleA}<br />
      <span class="hero__u">{c.hero.titleB}</span>
    </h1>
    <p class="lede hero__sub">{c.hero.sub}</p>
    <div class="hero__actions">
      <a href={start} class="btn">{c.hero.cta}</a>
    </div>
    <p class="hero__note">{c.hero.note}</p>
  </div>
  <div class="wrap scene">
    <div class="plate" dir="ltr">
      <div class="plate__stage" data-ss-fill>
        <HeroDemo client:visible lang={t.lang} ask={c.hero.demo.ask} reply={c.hero.demo.reply} />
      </div>
    </div>
  </div>
</section>

<!-- 2. The problem -->
<section class="problem" id="problem">
  <div class="wrap problem__grid">
    <h2 class="problem__title">{c.problem.titleA} <span>{c.problem.titleB}</span></h2>
    <div class="problem__copy lede">
      {c.problem.body.map((x) => <p>{x}</p>)}
    </div>
    <div class="fact glass">
      <span class="fact__n ltr">{c.problem.fact.value}</span>
      <p>{c.problem.fact.text}</p>
      <cite><a href={c.problem.fact.href} rel="noopener">{c.problem.fact.cite}</a></cite>
    </div>
  </div>
</section>

{segments && (
  <section class="segs" id="segments">
    <div class="wrap">
      <h2 class="h2">{t.segments.title}</h2>
      <p class="lede segs__sub">{t.segments.sub}</p>
      <div class="segs__grid">
        {t.segments.items.map((g) => (
          <div class="seg glass">
            <h3>{g.name}</h3>
            <p>{g.leak}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- 3. The plan -->
<section class="moves" id="how">
  <div class="wrap moves__grid">
    <div class="moves__intro">
      <h2 class="h2">{c.plan.titleA}<br />{c.plan.titleB}</h2>
      <p class="lede">{c.plan.sub}</p>
    </div>
    <ol class="moves__list glass">
      <li class="move">
        <span class="move__n">{c.plan.steps[0].n}</span>
        <div>
          <h3>{c.plan.steps[0].title}</h3>
          <p>{c.plan.steps[0].body}</p>
        </div>
        <div class="frag" aria-hidden="true">
          <div class="chips">
            {p.channels.map((c, i) => <span class={i === 0 ? 'on' : ''}>{c}</span>)}
          </div>
          <span class="replied">{p.replied}</span>
        </div>
      </li>
      <li class="move">
        <span class="move__n">{c.plan.steps[1].n}</span>
        <div>
          <h3>{c.plan.steps[1].title}</h3>
          <p>{c.plan.steps[1].body}</p>
        </div>
        <div class="frag" aria-hidden="true">
          <ul class="checks">
            {p.checks.map((x, i) => <li class={i === p.checks.length - 1 ? 'is-done' : ''}>{x}</li>)}
          </ul>
        </div>
      </li>
      <li class="move">
        <span class="move__n">{c.plan.steps[2].n}</span>
        <div>
          <h3>{c.plan.steps[2].title}</h3>
          <p>{c.plan.steps[2].body}</p>
        </div>
        <div class="frag" aria-hidden="true">
          <p class="bubble">{p.reminder}</p>
          <span class="pill-booked">{p.booked}</span>
        </div>
      </li>
      <li class="move">
        <span class="move__n">{c.plan.steps[3].n}</span>
        <div>
          <h3>{c.plan.steps[3].title}</h3>
          <p>{c.plan.steps[3].body}</p>
        </div>
        <div class="frag" aria-hidden="true">
          <p class="bubble">{p.showReminder}</p>
          <p class="bubble bubble--them">{p.showReply}</p>
          <span class="pill-booked">{p.confirmed}</span>
        </div>
      </li>
    </ol>
  </div>
</section>

<!-- 4. Proof -->
<section class="proof-sec" id="results">
  <div class="wrap">
    <h2 class="h2">{c.results.title}</h2>
    <p class="lede proof-sec__sub">{c.results.body}</p>
    <div class="board glass">
      <div class="board__table">
        <div class="board__row board__row--head">
          {c.results.table.head.map((h) => <span>{h}</span>)}
        </div>
        {c.results.table.rows.map((r, i) => (
          <div class={`board__row ${i === 0 ? 'is-top' : ''}`}>
            <span>{r[0]}</span>
            <span class="ltr">{r[1]}</span>
            <span class="ltr board__after">{r[2]}</span>
          </div>
        ))}
        <p class="board__note">{c.results.note}</p>
      </div>
      <div class="board__side">
        <span class="board__big ltr">{c.results.big.value}</span>
        <span class="board__label">{c.results.big.label}</span>
        <span class="board__by">{c.results.by}</span>
      </div>
    </div>
  </div>
</section>

<!-- 5. What they get -->
<section class="get">
  <div class="wrap get__grid">
    <div class="cal glass" aria-hidden="true">
      <div class="cal__head">
        <div>
          <b>{c.outcomes.card.title}</b>
          <span class="cal__tag">{c.outcomes.card.tag}</span>
        </div>
      </div>
      {c.outcomes.card.rows.map((r, i) => (
        <div class={`cal__row ${i === 0 ? 'is-first' : ''}`}>
          <span class="cal__when"><b>{r.day}</b> {r.time}</span>
          <span class="cal__name">{r.name}</span>
          <span class={`cal__status ${i < 3 ? 'is-booked' : 'is-you'}`}>{r.status}</span>
        </div>
      ))}
    </div>
    <div class="get__copy">
      <h2 class="h2">{c.outcomes.titleA}<br />{c.outcomes.titleB}</h2>
      <p class="lede">{c.outcomes.sub}</p>
      <ol class="get__list">
        {c.outcomes.items.map((x, i) => (
          <li><span>{`0${i + 1}`}</span>{x}</li>
        ))}
      </ol>
      <a href={start} class="btn">{c.outcomes.cta}</a>
    </div>
  </div>
</section>

<!-- 6. Soft call to action -->
<section class="soft">
  <div class="wrap">
    <div class="soft__bar glass">
      <div>
        <h2 class="soft__title">{c.soft.title}</h2>
        <p class="soft__body">{c.soft.body}</p>
      </div>
      <a href={start} class="btn btn--ghost soft__btn">{c.soft.cta}</a>
    </div>
  </div>
</section>

<!-- 7. The call to action -->
<section class="closing">
  <div class="wrap">
    <div class="closing__card glass">
      <svg class="closing__mark" viewBox="0 0 100 100" aria-hidden="true"><path fill="#0A6CFF" d="M72.96 9.37L43.06 15.46L46.42 33.25L26.57 10.61L16.28 37.56L32.06 44.06L1.92 48.79L22.55 71.84L35.85 60.19L26.51 88.98L56.35 84.43L53.46 66.10L74.50 90.57L85.61 59.60L67.58 53.75L98.02 46.90L77.87 25.03L64.33 37.26Z" /></svg>
      <h2 class="h2">{c.final.title}</h2>
      <p class="lede">{c.final.sub}</p>
      <a href={start} class="btn">{c.final.cta}</a>
      <p class="closing__small">{c.final.small}</p>
      <svg class="closing__wave" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 150 C 220 70, 420 70, 620 120 S 1000 190, 1200 90" />
      </svg>
    </div>
  </div>
</section>

<style>
  /* Hero: centred, two lines, the second underlined */
  .hero {
    padding-top: clamp(120px, 15vh, 150px);
    text-align: center;
  }
  .hero__title {
    font-size: clamp(40px, 5.5vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  :global(:root[lang='ar']) .hero__title {
    letter-spacing: 0;
    line-height: 1.25;
  }
  /* Underline that follows the words, even when the line wraps */
  .hero__u {
    text-decoration-line: underline;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 0.075em;
    text-underline-offset: 0.1em;
    text-decoration-skip-ink: none;
  }
  .hero__sub {
    max-width: 40ch;
    margin: 30px auto 0;
  }
  .hero__actions {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }
  .hero__note {
    margin-top: 18px;
    color: rgba(30, 28, 33, 0.6);
    font-size: 14px;
  }

  /* The product on a Convrt Blue plate */
  .scene {
    margin-top: clamp(52px, 8vh, 84px);
  }
  .plate {
    position: relative;
    overflow: hidden;
    padding: 0 clamp(16px, 4vw, 52px);
    border-radius: var(--r-xl);
    background-color: var(--blue);
    background-image: var(--grain-color);
  }
  .plate__stage {
    max-width: 980px;
    margin-inline: auto;
  }

  /* Problem: a big split headline, one sourced fact */
  .problem {
    padding: clamp(110px, 16vh, 180px) 0 clamp(80px, 12vh, 130px);
  }
  .problem__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 28px;
    align-items: end;
  }
  .problem__title {
    grid-column: 1 / span 7;
    font-size: clamp(42px, 6.4vw, 92px);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }
  :global(:root[lang='ar']) .problem__title {
    line-height: 1.2;
  }
  .problem__title span {
    color: rgba(30, 28, 33, 0.45);
  }
  .problem__copy {
    grid-column: 9 / span 4;
    padding-bottom: 10px;
  }
  .problem__copy p + p {
    margin-top: 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .fact {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    margin-top: clamp(40px, 6vh, 72px);
    padding: clamp(26px, 3.4vw, 44px) clamp(26px, 4vw, 56px);
  }
  .fact__n {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(72px, 9vw, 132px);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.9;
    color: var(--blue);
  }
  .fact p {
    max-width: 36ch;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.42;
    letter-spacing: -0.018em;
  }
  .fact cite {
    align-self: end;
    font-style: normal;
    font-size: 13px;
  }
  .fact cite a {
    color: rgba(30, 28, 33, 0.6);
  }

  /* Who we help: one card per kind of business */
  .segs {
    padding: clamp(40px, 6vh, 80px) 0 clamp(60px, 9vh, 110px);
  }
  .segs__sub {
    max-width: 48ch;
    margin-top: 18px;
  }
  .segs__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-top: 44px;
  }
  .seg {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: var(--r-m);
    color: var(--ink);
    text-decoration: none;
  }
  .seg:nth-child(n + 4) {
    grid-column: span 3;
  }
  .seg h3 {
    font-size: 22px;
    letter-spacing: -0.025em;
  }
  .seg p {
    color: var(--ink-2);
    font-size: 16px;
  }
  .seg--link {
    background-color: var(--charcoal);
    background-image: var(--grain-color);
    color: #fff;
    transition: transform 0.25s var(--spring);
  }
  .seg--link:hover {
    transform: translateY(-3px);
  }
  .seg--link h3 {
    color: #fff;
  }
  .seg--link p {
    color: rgba(255, 255, 255, 0.75);
  }
  .seg__more {
    margin-top: auto;
    padding-top: 8px;
    color: var(--lime);
    font-weight: 600;
    font-size: 15px;
  }
  :global(:root[dir='rtl']) .seg__more span {
    display: inline-block;
    transform: scaleX(-1);
  }

  /* Plan: intro on the left, the steps in one glass card */
  .moves {
    padding: clamp(60px, 10vh, 120px) 0;
  }
  .moves__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 28px;
    align-items: start;
  }
  .moves__intro {
    grid-column: 1 / span 4;
    position: sticky;
    top: 124px;
  }
  .moves__intro .lede {
    max-width: 30ch;
    margin-top: 22px;
  }
  .moves__list {
    grid-column: 6 / -1;
    margin: 0;
    padding: 8px clamp(22px, 2.6vw, 36px);
    list-style: none;
  }
  .move {
    display: grid;
    grid-template-columns: 44px 1fr 232px;
    align-items: center;
    gap: 22px;
    padding: 30px 0;
  }
  .move + .move {
    border-top: 1px solid var(--hair);
  }
  .move__n {
    align-self: start;
    padding-top: 6px;
    color: rgba(30, 28, 33, 0.6);
    font-size: 13px;
    font-weight: 500;
  }
  .move h3 {
    font-size: 24px;
    letter-spacing: -0.03em;
  }
  .move p {
    max-width: 30ch;
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 16px;
  }
  .frag {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    min-height: 100px;
    padding: 14px;
    border-radius: 18px;
    background: var(--glass-inset);
    box-shadow: inset 0 0 0 1px var(--hair);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips span {
    padding: 5px 10px;
    border-radius: 999px;
    color: rgba(30, 28, 33, 0.6);
    font-size: 12.5px;
    box-shadow: inset 0 0 0 1px var(--hair);
  }
  .chips .on {
    background: var(--tint);
    color: var(--blue-deep);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px rgba(11, 118, 245, 0.35);
  }
  .replied {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--lime);
    color: var(--charcoal);
    font-size: 12.5px;
    font-weight: 600;
  }
  .replied::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--charcoal);
  }
  .checks {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-2);
    font-size: 13px;
  }
  .checks li::before {
    content: '✓';
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    flex: none;
    border-radius: 50%;
    background: var(--tint);
    color: var(--blue-deep);
    font-size: 11px;
    font-weight: 700;
  }
  .checks li.is-done {
    color: var(--ink);
    font-weight: 600;
  }
  .checks li.is-done::before {
    background: var(--lime);
    color: var(--charcoal);
  }
  .frag .bubble {
    margin-top: 0;
    align-self: flex-end;
    max-width: 92%;
    padding: 9px 12px;
    border-radius: 16px 16px 6px 16px;
    background: var(--blue);
    color: #fff;
    font-size: 13px;
    line-height: 1.4;
  }
  .frag .bubble--them {
    align-self: flex-start;
    padding: 6px 14px;
    border-radius: 16px 16px 16px 6px;
    background: #fff;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--hair);
  }
  :global(:root[dir='rtl']) .bubble--them {
    border-radius: 16px 16px 6px 16px !important;
  }
  :global(:root[dir='rtl']) .bubble {
    border-radius: 16px 16px 16px 6px;
  }
  .pill-booked {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--lime);
    color: var(--charcoal);
    font-size: 12.5px;
    font-weight: 600;
  }

  /* Proof: a results table and one big number */
  .proof-sec {
    padding: clamp(60px, 10vh, 120px) 0;
  }
  .proof-sec__sub {
    max-width: 52ch;
    margin-top: 18px;
  }
  .board {
    display: grid;
    grid-template-columns: 1fr 340px;
    margin-top: 48px;
    overflow: hidden;
    border-radius: var(--r-xl);
  }
  .board__table {
    padding: 28px;
  }
  .board__row {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    align-items: center;
    gap: 12px;
    padding: 16px 14px;
    border-radius: 14px;
    font-size: 16px;
  }
  .board__row + .board__row:not(.is-top) {
    border-top: 1px solid var(--hair);
  }
  .board__row--head {
    padding-block: 6px 12px;
    color: rgba(30, 28, 33, 0.6);
    font-size: 13px;
  }
  .board__row.is-top {
    background: rgba(255, 255, 255, 0.85);
    box-shadow: var(--lift-s);
    font-weight: 600;
  }
  .board__row.is-top + .board__row {
    border-top: 0;
  }
  .board__after {
    color: var(--blue-deep);
    font-weight: 600;
  }
  .board__note {
    margin-top: 16px;
    padding-inline: 14px;
    color: rgba(30, 28, 33, 0.55);
    font-size: 12.5px;
  }
  .board__side {
    display: grid;
    align-content: center;
    gap: 8px;
    padding: 36px;
    background-color: var(--blue);
    background-image: var(--grain-color);
    color: #fff;
  }
  .board__big {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(64px, 7vw, 104px);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }
  .board__label {
    max-width: 22ch;
    color: rgba(255, 255, 255, 0.86);
    font-size: 17px;
  }
  .board__by {
    margin-top: 18px;
    color: rgba(255, 255, 255, 0.65);
    font-size: 13px;
  }

  /* What they get: a week of booked consultations, and the list */
  .get {
    padding: clamp(60px, 10vh, 120px) 0;
  }
  .get__grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .cal {
    padding: 26px;
  }
  .cal__head {
    margin-bottom: 16px;
  }
  .cal__head b {
    display: block;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .cal__tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    color: var(--blue-deep);
    font-size: 13px;
    font-weight: 500;
  }
  .cal__tag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
  }
  .cal__row {
    display: grid;
    grid-template-columns: 1.2fr 1fr auto;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    padding: 16px 18px;
    border-radius: 16px;
    background: var(--glass-inset);
    font-size: 15px;
  }
  .cal__row.is-first {
    background: rgba(255, 255, 255, 0.9);
    box-shadow: var(--lift-s);
  }
  .cal__when {
    color: rgba(30, 28, 33, 0.6);
  }
  .cal__when b {
    color: var(--ink);
    font-weight: 600;
  }
  .cal__name {
    font-weight: 500;
  }
  .cal__status {
    padding: 4px 10px;
    border-radius: 99px;
    background: rgba(30, 28, 33, 0.06);
    color: var(--ink-2);
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
  }
  .cal__status.is-booked {
    background: var(--lime);
    color: var(--charcoal);
    font-weight: 600;
  }
  .cal__status.is-you {
    background: #ffe9c7;
    color: #8a4b00;
    font-weight: 600;
  }
  .get__copy .lede {
    margin-top: 20px;
  }
  .get__list {
    margin: 28px 0 32px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }
  .get__list li {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hair);
    font-size: 17px;
  }
  .get__list span {
    color: rgba(30, 28, 33, 0.55);
    font-size: 13px;
    padding-top: 3px;
  }

  /* Soft call to action: one quiet bar */
  .soft {
    padding: clamp(40px, 7vh, 80px) 0 0;
  }
  .soft__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 26px 30px;
    border-radius: var(--r-m);
  }
  .soft__title {
    font-size: 22px;
    letter-spacing: -0.025em;
  }
  .soft__body {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 16px;
  }
  .soft__btn {
    flex: none;
  }

  /* Closing card with a wave */
  .closing {
    padding: clamp(80px, 12vh, 140px) 0 clamp(60px, 9vh, 100px);
  }
