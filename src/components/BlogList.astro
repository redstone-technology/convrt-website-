---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import type { Dict } from '../i18n/en'
interface Props { t: Dict }
const { t } = Astro.props
const prefix = t.lang === 'ar' ? '/ar/blog' : '/blog'
const posts = (await getCollection('blog', (p) => p.id.startsWith(`${t.lang}/`))).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const fmt = new Intl.DateTimeFormat(t.lang === 'ar' ? 'ar-QA' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---
<Base t={t} enPath="/blog" title={`${t.blog.title} | Convrt`} description={t.blog.sub}>
  <section class="section wrap">
    <h1 class="bl__title">{t.blog.title}</h1>
    <p class="lead">{t.blog.sub}</p>
    <div class="bl__grid">
      {posts.map((p) => (
        <a class="bl__card" href={`${prefix}/${p.id.split('/')[1]}`}>
          <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
          <h2>{p.data.title}</h2>
          <p>{p.data.description}</p>
          <span class="bl__read">{t.blog.read} <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .bl__title { font-size: clamp(40px, 5vw, 64px); }
  .bl__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 48px; }
  .bl__card { display: grid; gap: 10px; align-content: start; padding: 32px; border-radius: var(--radius); background: #fff; text-decoration: none; box-shadow: 0 1px 0 var(--line), 0 18px 40px -28px rgba(30,28,33,.25); transition: transform .2s ease; }
  .bl__card:hover { transform: translateY(-2px); }
  .bl__card time { color: var(--ink-3); font-size: 14px; }
  .bl__card h2 { font-size: 26px; letter-spacing: -0.02em; line-height: 1.2; }
  .bl__card p { color: var(--ink-2); }
  .bl__read { margin-top: 8px; color: var(--blue); font-weight: 600; }
  :global(:root[dir='rtl']) .bl__read .arrow { display: inline-block; transform: scaleX(-1); }
  @media (max-width: 800px) { .bl__grid { grid-template-columns: 1fr; } }
</style>
